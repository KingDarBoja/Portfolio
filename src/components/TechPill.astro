export interface Props {
	name: TechnologyId | (string & {});
}

const { name } = Astro.props;
const techInfo = technologies[name as TechnologyId];
const label = techInfo?.label || name;
const bgColor = techInfo?.bg_color;
const iconRaw = techInfo?.icon_raw;
---

<span class="tech-pill" style={bgColor ? `--pill-bg: ${bgColor}` : undefined}>
	{iconRaw && <span class="pill-icon" set:html={iconRaw} />}
	<span class="pill-label">{label}</span>
</span>

<style lang="scss">
	.tech-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-family: var(--font-jetbrainsmono), Consolas, monospace;
		font-size: 0.6rem;
		line-height: 1.2;
		font-weight: 600;
		letter-spacing: 0.03em;
		border-radius: 5px;
		padding: 0.18rem 0.45rem;
		background: var(--pill-bg, var(--bg-secondary));
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.15);
		box-shadow: 0 2px 6px var(--shadow-color);
		transition: all 0.2s ease;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);

		// If pill is bright yellow like JavaScript, adjust text color for contrast
		&:has(.pill-label) {
			text-decoration: none;
		}

		.pill-icon {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 11px;
			height: 11px;
			flex-shrink: 0;

			:global(svg) {
				width: 100%;
				height: 100%;
				fill: currentColor;
				display: block;
			}
		}

		.pill-label {
			line-height: 1.2;
			white-space: nowrap;
		}

		&:hover {
			border-color: rgba(255, 255, 255, 0.4);
			box-shadow: 0 0 10px var(--border-glow);
			transform: translateY(-1px);
			filter: brightness(1.1);
		}
	}

	// Specific color tuning for low-contrast backgrounds like JavaScript yellow
	.tech-pill[style*="#F7DF1E"],
	.tech-pill[style*="#FFCA28"],
	.tech-pill[style*="#F7B93E"] {
		color: #1a1c24;
		text-shadow: none;

		.pill-icon :global(svg) {
			fill: #1a1c24;
		}
	}
</style>
